<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6E1F0B7C-3D0B-4E0D-9C55-0B1E8C5A7E11}</ProjectGuid>
    <RootNamespace>ElsExt</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>ElsExt</TargetName>
    <TargetExt>.asi</TargetExt>
    <OutDir>$(ProjectDir)bin\</OutDir>
    <IntDir>$(ProjectDir)obj\</IntDir>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <Optimization>MaxSpeed</Optimization>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- Static runtime: players do not need the Visual C++ redistributable. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>ELSEXT_EXPORTS;NDEBUG;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)third_party\minhook\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <AdditionalDependencies>$(IntDir)ScriptHookV.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreLinkEvent>
      <Command>lib /nologo /machine:x64 /def:"$(ProjectDir)src\ScriptHookV.def" /out:"$(IntDir)ScriptHookV.lib"</Command>
      <Message>Generating ScriptHookV import library</Message>
    </PreLinkEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\Diagnostics.cpp" />
    <ClCompile Include="src\Els.cpp" />
    <ClCompile Include="src\Fixes.cpp" />
    <ClCompile Include="src\Lighting.cpp" />
    <ClCompile Include="src\Log.cpp" />
    <ClCompile Include="src\Main.cpp" />
    <ClCompile Include="src\Requests.cpp" />
    <ClCompile Include="src\Settings.cpp" />
    <ClCompile Include="src\Sirens.cpp" />
    <ClCompile Include="src\Vcf.cpp" />
    <ClCompile Include="third_party\minhook\src\buffer.c">
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="third_party\minhook\src\hook.c">
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="third_party\minhook\src\trampoline.c">
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <ClCompile Include="third_party\minhook\src\hde\hde64.c">
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="include\ElsExt.h" />
    <ClInclude Include="src\Diagnostics.h" />
    <ClInclude Include="src\Els.h" />
    <ClInclude Include="src\ElsLayout.h" />
    <ClInclude Include="src\ElsVehState.h" />
    <ClInclude Include="src\Extension.h" />
    <ClInclude Include="src\Fixes.h" />
    <ClInclude Include="src\Lighting.h" />
    <ClInclude Include="src\Log.h" />
    <ClInclude Include="src\Natives.h" />
    <ClInclude Include="src\Requests.h" />
    <ClInclude Include="src\Settings.h" />
    <ClInclude Include="src\Sirens.h" />
    <ClInclude Include="src\Vcf.h" />
    <ClInclude Include="src\Xml.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
